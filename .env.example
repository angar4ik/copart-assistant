# Copart Tool — secrets template. Copy this file to `.env` and fill in your values.
# The real `.env` is gitignored and must never be committed.

# Copart login (member sign-in email + password)
COPART_EMAIL=
COPART_PASSWORD=

# Auto.dev API key (free at https://www.auto.dev)
AUTO_DEV_API_KEY=

# Run the browser in headless (windowless) mode. true = no Chrome window.
HEADLESS=true
